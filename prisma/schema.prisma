generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Measurement {
  id       Int      @id @default(autoincrement())
  deviceId   String   
  temperature  Float
  humidity     Float
  recordedAt  DateTime @db.Timestamptz
  measuredAt  DateTime? @db.Timestamptz
  @@index([deviceId, recordedAt])
  @@map("measurements")
}